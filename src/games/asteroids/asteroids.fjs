@@[target("javascript")]

// Asteroids — three composed state machines.
//
// CANONICAL: mirrors the Godot reference
// (frame-arcade/ch04-asteroids/frame/asteroids.fgd) exactly — same
// three systems (Ship / AsteroidField / Asteroids), states,
// transitions, the $InGame HSM parent, the game push$/pop$ pause
// (the three in-game children all inherit it from $InGame so resume
// returns to whichever was active), private state variables on
// $InHyperspace ($.timer / $.duration that exist only for the
// duration of that compartment), the `difficulty` system parameter,
// and the owned sub-systems. Only action bodies differ (JS):
// Vector2 becomes a plain {x, y} object, randf()/cos/sin become
// Math.*, court_size is {x, y}.

// Ship — predicate-pull for continuous state, host-push for one-shot moments.
//
// Continuous queries (can_fire / can_be_hit / is_visible / is_alive /
// get_lives) stay on the interface: the renderer polls them every frame
// and is a pure function of the answers. They're idempotent and
// renderer-agnostic.
//
// Discrete transition effects fire from $> / <$ handlers into a `host`
// object passed at construction. The host is a tiny adapter implemented
// once per renderer (AsteroidsScene.ts for Phaser, main.gd for Godot) —
// each turns the abstract event into its idiomatic effect. Same .fjs/.fgd
// body, target-appropriate side effects.
@@system Ship(host: any) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        get_hyperspaces_remaining(): int { @@:(this.hyperspaces_remaining) }

    interface:
        tick(dt: float)
        hit()
        hyperspace()
        respawn()
        fire()
        can_fire(): bool
        can_be_hit(): bool
        can_hyperspace(): bool
        is_visible(): bool
        is_alive(): bool
        get_lives(): int

    machine:
        $Alive {
            // Fire cooldown — state-local because it only ticks down
            // while the ship is Alive. Other states either can't fire
            // ($InHyperspace/$Exploding/$Dead) or get a free shot
            // ($Respawning, which is the invuln respawn beat). The
            // scene calls ship.fire() after spawning a bullet, which
            // resets the timer.
            $.cooldown: float = 0.0

            tick(dt: float) {
                if ($.cooldown > 0.0) {
                    $.cooldown = $.cooldown - dt
                }
            }

            fire() {
                $.cooldown = 0.22
            }

            hit() { -> $Exploding }

            // Classic Asteroids: only 3 hyperspace jumps per game.
            // The FSM owns the count so the scene can't accidentally
            // burn one — guard with can_hyperspace() before firing.
            hyperspace() {
                if (this.hyperspaces_remaining > 0) {
                    this.hyperspaces_remaining = this.hyperspaces_remaining - 1
                    -> $InHyperspace
                }
            }

            can_hyperspace(): bool { @@:(this.hyperspaces_remaining > 0) }

            can_fire(): bool    { @@:($.cooldown <= 0.0) }
            can_be_hit(): bool  { @@:(true) }
            is_visible(): bool  { @@:(true) }
            is_alive(): bool    { @@:(true) }
            get_lives(): int    { @@:(this.lives_remaining) }
        }

        $InHyperspace {
            $.timer: float = 0.0
            $.duration: float = 0.4

            $>() { this.host.warp_out() }
            <$() { this.host.warp_in() }

            tick(dt: float) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    -> "warp complete" $Alive
                }
            }

            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(true) }
            get_lives(): int       { @@:(this.lives_remaining) }
        }

        $Exploding {
            $.timer: float = 0.0
            $.duration: float = 1.0

            // One-shot effect: scatter debris from the ship's last position.
            // The scene knows where the sprite is; the FSM only announces
            // that an explosion has begun.
            $>() { this.host.spawn_explosion() }

            tick(dt: float) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    this.lives_remaining = this.lives_remaining - 1
                    if (this.lives_remaining <= 0) {
                        -> "no lives left" $Dead
                    } else {
                        -> "lives remain" $Respawning
                    }
                }
            }

            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(false) }
            get_lives(): int       { @@:(this.lives_remaining) }
        }

        $Respawning {
            $.timer: float = 0.0
            $.duration: float = 2.0

            // One-shot effect: place the ship at center with zero velocity.
            // The render-layer choice (snap vs. tween, particle flash) is
            // entirely up to the host.
            $>() { this.host.reset_ship() }

            tick(dt: float) {
                $.timer = $.timer + dt
                if ($.timer >= $.duration) {
                    -> "invuln expired" $Alive
                }
            }

            can_fire(): bool       { @@:(true) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(true) }
            is_alive(): bool       { @@:(true) }
            get_lives(): int       { @@:(this.lives_remaining) }
        }

        $Dead {
            respawn() {
                this.lives_remaining = this.starting_lives
                this.hyperspaces_remaining = this.starting_hyperspaces
                -> $Alive
            }

            can_fire(): bool       { @@:(false) }
            can_be_hit(): bool     { @@:(false) }
            can_hyperspace(): bool { @@:(false) }
            is_visible(): bool     { @@:(false) }
            is_alive(): bool       { @@:(false) }
            get_lives(): int       { @@:(0) }
        }

    domain:
        host: any = host
        lives_remaining: int = 3
        starting_lives: int = 3
        hyperspaces_remaining: int = 3
        starting_hyperspaces: int = 3
}

@@system AsteroidField {

    interface:
        spawn_wave(count: int, court_size: Vector2)
        split(index: int): bool
        remove(index: int)
        clear()
        advance(dt: float, court_size: Vector2)
        count(): int
        alive_count(): int
        is_alive(index: int): bool
        position(index: int): Vector2
        velocity(index: int): Vector2
        size_of(index: int): int
        radius_of(index: int): float

    machine:
        $Active {
            spawn_wave(count: int, court_size: Vector2) {
                this._clear()
                let i = 0
                while (i < count) {
                    this._spawn_large(court_size)
                    i = i + 1
                }
            }

            split(index: int): bool {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return(false)
                }
                let a = this.asteroids[index]
                if (!a.alive) {
                    @@:return(false)
                }
                a.alive = false
                let sz = a.size
                if (sz > 1) {
                    this._spawn_child(a.pos, sz - 1)
                    this._spawn_child(a.pos, sz - 1)
                }
                @@:(true)
            }

            remove(index: int) {
                if (index < 0 || index >= this.asteroids.length) {
                    return
                }
                this.asteroids[index].alive = false
            }

            clear() {
                this._clear()
            }

            advance(dt: float, court_size: Vector2) {
                let i = 0
                while (i < this.asteroids.length) {
                    let a = this.asteroids[i]
                    if (a.alive) {
                        a.pos.x = a.pos.x + a.vel.x * dt
                        a.pos.y = a.pos.y + a.vel.y * dt
                        if (a.pos.x < 0.0) { a.pos.x = a.pos.x + court_size.x }
                        if (a.pos.x > court_size.x) { a.pos.x = a.pos.x - court_size.x }
                        if (a.pos.y < 0.0) { a.pos.y = a.pos.y + court_size.y }
                        if (a.pos.y > court_size.y) { a.pos.y = a.pos.y - court_size.y }
                    }
                    i = i + 1
                }
            }

            count(): int { @@:(this.asteroids.length) }

            alive_count(): int {
                let c = 0
                let i = 0
                while (i < this.asteroids.length) {
                    if (this.asteroids[i].alive) {
                        c = c + 1
                    }
                    i = i + 1
                }
                @@:(c)
            }

            is_alive(index: int): bool {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return(false)
                }
                @@:(this.asteroids[index].alive)
            }

            position(index: int): Vector2 {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return({ x: 0.0, y: 0.0 })
                }
                @@:(this.asteroids[index].pos)
            }

            velocity(index: int): Vector2 {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return({ x: 0.0, y: 0.0 })
                }
                @@:(this.asteroids[index].vel)
            }

            size_of(index: int): int {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return(0)
                }
                @@:(this.asteroids[index].size)
            }

            radius_of(index: int): float {
                if (index < 0 || index >= this.asteroids.length) {
                    @@:return(0.0)
                }
                let sz = this.asteroids[index].size
                if (sz == 3) { @@:return(32.0) }
                if (sz == 2) { @@:return(18.0) }
                @@:(10.0)
            }
        }

    actions:
        _clear() {
            this.asteroids = []
        }

        _spawn_large(court_size: Vector2) {
            let edge = Math.floor(Math.random() * 4)
            let pos = { x: 0.0, y: 0.0 }
            if (edge == 0) {
                pos = { x: 0.0, y: Math.random() * court_size.y }
            } else if (edge == 1) {
                pos = { x: court_size.x, y: Math.random() * court_size.y }
            } else if (edge == 2) {
                pos = { x: Math.random() * court_size.x, y: 0.0 }
            } else {
                pos = { x: Math.random() * court_size.x, y: court_size.y }
            }
            let angle = Math.random() * Math.PI * 2
            let speed = 40.0 + Math.random() * 30.0
            this.asteroids.push({ pos: pos, vel: { x: Math.cos(angle) * speed, y: Math.sin(angle) * speed }, size: 3, alive: true })
        }

        _spawn_child(pos: Vector2, size: int) {
            let angle = Math.random() * Math.PI * 2
            let speed = 60.0 + Math.random() * 40.0 + (3 - size) * 20.0
            this.asteroids.push({ pos: { x: pos.x, y: pos.y }, vel: { x: Math.cos(angle) * speed, y: Math.sin(angle) * speed }, size: size, alive: true })
        }

    domain:
        asteroids: list = []
}

@@[main]
@@system AsteroidsGame(difficulty: int = 2, ship_host: any = null) {

    operations:
        get_current_state_name(): string { @@:(@@:system.state.name) }
        // Bullet pool cap (classic Asteroids: 4 on screen). Surfaced as
        // operations so the renderer can compose its fire gate without
        // each state having to re-declare the query.
        get_bullets_in_flight(): int { @@:(this.bullets_in_flight) }
        get_max_bullets(): int       { @@:(this.max_bullets) }

    interface:
        start()
        restart()
        pause()
        resume()
        tick(dt: float, court_size: Vector2)
        ship_hit_asteroid(index: int)
        bullet_hit_asteroid(index: int)
        ship_hyperspace()
        // Renderer fires these when a bullet enters/leaves the world.
        // bullet_expired() covers both off-screen lifetime AND collision
        // (the renderer is closer to those events than the FSM is).
        bullet_fired()
        bullet_expired()
        get_score(): int
        get_lives(): int
        get_wave(): int
        get_difficulty(): int
        is_paused(): bool

    machine:
        $Attract {
            $>() {
                this.score = 0
                this.wave = 1
                this.bullets_in_flight = 0
            }

            start() {
                this.ship.respawn()
                this.field.spawn_wave(this._asteroids_for_wave(1), this.last_court_size)
                -> $Playing
            }

            get_score(): int        { @@:(this.score) }
            get_lives(): int        { @@:(this.ship.get_lives()) }
            get_wave(): int         { @@:(this.wave) }
            get_difficulty(): int   { @@:(this.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $InGame {
            pause() {
                push$ -> $Paused
            }

            // Bullet pool bookkeeping. Children of $InGame ($Playing,
            // $ShipDying, $WaveClear) all forward to $^ for unhandled
            // events, so bullet_fired/bullet_expired bubble here.
            bullet_fired() {
                this.bullets_in_flight = this.bullets_in_flight + 1
            }

            bullet_expired() {
                if (this.bullets_in_flight > 0) {
                    this.bullets_in_flight = this.bullets_in_flight - 1
                }
            }

            get_score(): int        { @@:(this.score) }
            get_lives(): int        { @@:(this.ship.get_lives()) }
            get_wave(): int         { @@:(this.wave) }
            get_difficulty(): int   { @@:(this.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

        $Playing => $InGame {
            tick(dt: float, court_size: Vector2) {
                this.last_court_size = court_size
                this.ship.tick(dt)
                this.field.advance(dt, court_size)
            }

            ship_hit_asteroid(index: int) {
                if (!this.ship.can_be_hit()) {
                    return
                }
                this.ship.hit()
                -> $ShipDying
            }

            bullet_hit_asteroid(index: int) {
                if (this.field.split(index)) {
                    let sz = this._size_points(index)
                    this.score = this.score + sz * this.difficulty
                    if (this.field.alive_count() <= 0) {
                        -> "all asteroids cleared" $WaveClear
                    }
                }
            }

            ship_hyperspace() {
                this.ship.hyperspace()
            }

            => $^
        }

        $ShipDying => $InGame {
            tick(dt: float, court_size: Vector2) {
                this.last_court_size = court_size
                this.ship.tick(dt)
                this.field.advance(dt, court_size)
                if (this.ship.get_current_state_name() == "Respawning") {
                    -> "ship respawning" $Playing
                } else if (this.ship.get_current_state_name() == "Dead") {
                    -> "no lives left" $GameOver
                }
            }

            => $^
        }

        $WaveClear => $InGame {
            $>() {
                this.wave_timer = 0.0
            }

            tick(dt: float, court_size: Vector2) {
                this.last_court_size = court_size
                this.ship.tick(dt)
                this.wave_timer = this.wave_timer + dt
                if (this.wave_timer >= this.wave_pause) {
                    this.wave = this.wave + 1
                    this.field.spawn_wave(this._asteroids_for_wave(this.wave), court_size)
                    -> "next wave" $Playing
                }
            }

            => $^
        }

        $Paused {
            resume() {
                -> pop$
            }

            get_score(): int        { @@:(this.score) }
            get_lives(): int        { @@:(this.ship.get_lives()) }
            get_wave(): int         { @@:(this.wave) }
            get_difficulty(): int   { @@:(this.difficulty) }
            is_paused(): bool       { @@:(true) }
        }

        $GameOver {
            restart() {
                -> $Attract
            }

            get_score(): int        { @@:(this.score) }
            get_lives(): int        { @@:(this.ship.get_lives()) }
            get_wave(): int         { @@:(this.wave) }
            get_difficulty(): int   { @@:(this.difficulty) }
            is_paused(): bool       { @@:(false) }
        }

    actions:
        _asteroids_for_wave(wave: int) {
            let base = 2 + this.difficulty
            return base + wave - 1
        }

        _size_points(index: int) {
            let sz = this.field.size_of(index)
            if (sz == 3) { return 20 }
            if (sz == 2) { return 50 }
            return 100
        }

    domain:
        difficulty: int = difficulty
        score: int = 0
        wave: int = 1
        wave_timer: float = 0.0
        wave_pause: float = 2.0
        bullets_in_flight: int = 0
        max_bullets: int = 4
        last_court_size: Vector2 = { x: 640.0, y: 480.0 }
        ship = @@Ship(ship_host)
        field = @@AsteroidField()
}
